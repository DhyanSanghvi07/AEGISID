# ==========================================
# AEGISID - Root .gitignore
# ==========================================

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# Frontend local environment
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Backend local environment
backend/.env

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ---------- Backend generated files ----------
backend/uploads/*
!backend/uploads/.gitkeep

backend/audit_logs/*
!backend/audit_logs/.gitkeep

# ---------- Node / Next.js ----------
node_modules/
frontend/node_modules/

.next/
frontend/.next/

out/
frontend/out/

# Next.js / Vercel
.vercel/
frontend/.vercel/

# ---------- Build / cache ----------
dist/
build/
frontend/dist/
frontend/build/

.cache/
.parcel-cache/
.turbo/

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---------- OS generated ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml

# ---------- Temporary files ----------
*.tmp
*.temp
*.swp
*.swo
*~

# ---------- Test / coverage ----------
coverage/
.pytest_cache/

# ---------- TypeScript ----------
*.tsbuildinfo

# ---------- Misc ----------
*.bak
*.orig